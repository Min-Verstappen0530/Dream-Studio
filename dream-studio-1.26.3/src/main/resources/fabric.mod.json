    "fabric-key-mapping-api-v1": "*",
    "fabric-creative-tab-api-v1": "*",
    "fabric-menu-api-v1": "*",
    "fabric-networking-api-v1": "*",
    "fabric-lifecycle-events-v1": "*"
  },
  "suggests": {
    "iris": ">=1.11.5"
  },
  "authors": [
    "Min_Verstappen_"
  ],
  "license": "LGPL-3.0-only",
  "contact": {
    "homepage": "https://modrinth.com/project/dream-studio"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.physical_camera.modrinth": "https://modrinth.com/project/dream-studio"
      }
    }
  }
