{
  "schemaVersion": 1,
  "id": "physical_camera",
  "version": "1.0.2",
  "name": "梦幻摄影 / Dream Studio",
  "description": "Take photos in Minecraft. Set exposure and focus, simulate how a lens and sensor form an image, and save editable DNG RAW files.",
  "icon": "assets/physical_camera/icon.png",
  "environment": "*",
  "mixins": [
    "physical_camera.mixins.json"
  ],
  "entrypoints": {
